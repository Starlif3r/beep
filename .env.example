# Beep — Configuration
#
# Copy to .env and fill in your keys.
# More NVIDIA keys = more throughput. No upper limit.
# Beep rotates them automatically and handles rate limits.

MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
PORT=8083
HOST=0.0.0.0
BACKEND=nvidia

# NVIDIA API Keys — comma-separated, unlimited keys supported
# Get yours at https://build.nvidia.com/
# Example with 5 keys: nvapi-key1,nvapi-key2,nvapi-key3,nvapi-key4,nvapi-key5
# Add as many as you like. 10, 50, 100 — Beep handles them all.
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3

# Local models via Ollama (optional)
# OLLAMA_URL=http://localhost:11434

# MemPalace memory system (auto-initialized, no config needed)
# Palace path: ~/.mempalace/palace
# MEMPALACE_PALACE_PATH=/custom/path/to/palace
